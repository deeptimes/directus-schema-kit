{
  "name": "@deeptimes/directus-schema-kit",
  "version": "1.1.0",
  "description": "Declarative schema provisioning toolkit for Directus",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsk": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "test:integration": "node --import tsx --test 'test/integration/**/*.test.ts'",
    "check:release": "pnpm typecheck && pnpm test && pnpm build && pnpm pack --dry-run",
    "prepack": "pnpm build"
  },
  "keywords": [
    "directus",
    "schema",
    "provisioning",
    "cli"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
