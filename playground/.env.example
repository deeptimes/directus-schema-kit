SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Directus 在首次 bootstrap 时为管理员写入的静态 API Token。
ADMIN_TOKEN=replace-with-a-secure-static-token

DB_CLIENT=sqlite3
DB_FILENAME=./database/data.db
PUBLIC_URL=http://localhost:8055
WEBSOCKETS_ENABLED=true

# v12 博客权限依赖 custom_permission_rules_enabled；在 Directus 中配置相应 license。
# LICENSE_KEY=your-directus-license-key
