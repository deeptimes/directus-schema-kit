// Blog Template for Directus Schema Kit
// directus_* 表仅为关系图引用，不属于本模板管理范围。

Enum blog_content_access {
  public
  member
}

Enum blog_membership_status {
  active
  expired
  suspended
}

Table directus_users [note: 'Directus system table; reference only'] {
  id uuid [pk]
}

Table directus_folders [note: 'Directus system table; reference only'] {
  id uuid [pk]
}

Table directus_files [note: 'Directus system table; reference only'] {
  id uuid [pk]
  folder uuid [ref: > directus_folders.id]
}

Table blog_categories {
  id uuid [pk]
  status varchar(32) [not null, default: 'draft', note: 'draft | published | archived']
  sort integer
  name varchar(120) [not null]
  slug varchar(160) [not null, unique]
  description text
  image uuid [ref: > directus_files.id]
  user_created uuid [ref: > directus_users.id]
  date_created timestamp
  user_updated uuid [ref: > directus_users.id]
  date_updated timestamp
}

Table blog_tags {
  id uuid [pk]
  status varchar(32) [not null, default: 'draft', note: 'draft | published | archived']
  sort integer
  name varchar(80) [not null]
  slug varchar(120) [not null, unique]
  description text
  color varchar(32)
  user_created uuid [ref: > directus_users.id]
  date_created timestamp
  user_updated uuid [ref: > directus_users.id]
  date_updated timestamp
}

Table blog_posts {
  id uuid [pk]
  status varchar(32) [not null, default: 'draft', note: 'draft | published | archived']
  sort integer
  slug varchar(200) [not null, unique]
  title varchar(255) [not null]
  summary text [not null]
  content text [not null, note: 'Markdown content']
  access_level blog_content_access [not null, default: 'public']
  reading_minutes integer [not null, default: 1]
  is_featured boolean [not null, default: false]
  keywords json
  seo json
  category uuid [not null, ref: > blog_categories.id]
  user_author uuid [ref: > directus_users.id]
  cover uuid [ref: > directus_files.id]
  featured_video uuid [ref: > directus_files.id]
  date_published timestamp
  user_created uuid [ref: > directus_users.id]
  date_created timestamp
  user_updated uuid [ref: > directus_users.id]
  date_updated timestamp

  indexes {
    status
    access_level
    category
    date_published
  }
}

Table blog_member_profiles {
  id uuid [pk]
  status varchar(32) [not null, default: 'draft', note: 'draft | published | archived']
  display_name varchar(120) [not null]
  biography text
  website varchar(255)
  membership_status blog_membership_status [not null, default: 'active']
  date_membership_expires timestamp
  preferences json
  user_account uuid [not null, unique, ref: > directus_users.id]
  user_created uuid [ref: > directus_users.id]
  date_created timestamp
  user_updated uuid [ref: > directus_users.id]
  date_updated timestamp
}

Table blog_comments {
  id uuid [pk]
  status varchar(32) [not null, default: 'draft', note: 'draft | published | archived']
  content text [not null]
  is_pinned boolean [not null, default: false]
  post uuid [ref: > blog_posts.id]
  parent uuid [ref: > blog_comments.id]
  user_author uuid [ref: > directus_users.id]
  user_created uuid [ref: > directus_users.id]
  date_created timestamp
  user_updated uuid [ref: > directus_users.id]
  date_updated timestamp

  indexes {
    status
    post
    parent
  }
}

Table blog_downloads {
  id uuid [pk]
  status varchar(32) [not null, default: 'draft', note: 'draft | published | archived']
  sort integer
  slug varchar(200) [not null, unique]
  title varchar(255) [not null]
  description text
  access_level blog_content_access [not null, default: 'member']
  download_count integer [not null, default: 0]
  date_available_from timestamp
  date_available_until timestamp
  post uuid [ref: > blog_posts.id]
  file uuid [not null, ref: > directus_files.id]
  user_created uuid [ref: > directus_users.id]
  date_created timestamp
  user_updated uuid [ref: > directus_users.id]
  date_updated timestamp

  indexes {
    status
    access_level
    post
  }
}

Table blog_posts_tags {
  id uuid [pk]
  blog_posts_id uuid [not null, ref: > blog_posts.id]
  blog_tags_id uuid [not null, ref: > blog_tags.id]
  sort integer

  indexes {
    (blog_posts_id, blog_tags_id) [unique]
  }
}

Table blog_posts_files {
  id integer [pk, increment]
  blog_posts_id uuid [ref: > blog_posts.id]
  directus_files_id uuid [ref: > directus_files.id]
  sort integer
}
