{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeptimes.dev/dsk/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "generator", "source", "collections", "fields", "relations", "resources"],
  "properties": {
    "manifestVersion": { "const": 3 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "files"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "collections": { "type": "array", "items": { "$ref": "#/$defs/collection" } },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folders", "roles", "policies", "access", "permissions", "presets"],
      "properties": {
        "folders": { "type": "array" },
        "roles": { "type": "array" },
        "policies": { "type": "array" },
        "access": { "type": "array" },
        "permissions": { "type": "array" },
        "presets": { "type": "array" }
      }
    }
  },
  "$defs": {
    "collection": {
      "type": "object", "additionalProperties": false,
      "required": ["collection", "meta", "schema", "fields", "source"],
      "properties": {
        "collection": { "type": "string", "minLength": 1 }, "meta": { "type": "object" },
        "schema": { "type": ["object", "null"] }, "fields": { "type": "array", "maxItems": 0 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["collection", "field", "type", "meta", "schema", "source"],
      "properties": {
        "collection": { "type": "string", "minLength": 1 }, "field": { "type": "string", "minLength": 1 },
        "type": { "enum": ["alias", "bigInteger", "binary", "boolean", "csv", "date", "dateTime", "decimal", "float", "geometry", "geometry.Point", "geometry.LineString", "geometry.Polygon", "geometry.MultiPoint", "geometry.MultiLineString", "geometry.MultiPolygon", "hash", "integer", "json", "string", "text", "time", "timestamp", "uuid"] },
        "meta": { "type": "object" }, "schema": { "type": ["object", "null"] }, "source": { "type": "string", "minLength": 1 }
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["collection", "field", "related_collection", "schema", "source"],
      "properties": {
        "collection": { "type": "string", "minLength": 1 }, "field": { "type": "string", "minLength": 1 },
        "related_collection": { "type": ["string", "null"] }, "schema": { "type": ["object", "null"] },
        "meta": {
          "type": "object",
          "properties": {
            "many_collection": { "type": "string" }, "many_field": { "type": "string" },
            "one_collection": { "type": ["string", "null"] }, "one_field": { "type": ["string", "null"] },
            "one_collection_field": { "type": ["string", "null"] },
            "one_allowed_collections": { "type": ["array", "null"], "items": { "type": "string" } },
            "junction_field": { "type": ["string", "null"] }, "sort_field": { "type": ["string", "null"] },
            "one_deselect_action": { "enum": ["nullify", "delete"] }
          }
        },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
